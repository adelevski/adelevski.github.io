---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pageType?: "website" | "article";
  socialImage?: string | null;
  socialImageAlt?: string;
  mainClass?: string;
}

const {
  title,
  description,
  pageType = "website",
  socialImage = "/og.png",
  socialImageAlt = "Atanas Delevski - Quantitative developer - Software projects and technical writing",
  mainClass,
} = Astro.props;
const pageTitle =
  title === "Atanas Delevski" ? title : `${title} | Atanas Delevski`;
const path = Astro.url.pathname;
const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site ?? Astro.url).href
  : undefined;
const navigation = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/writing/", label: "Writing" },
  { href: "/principles/", label: "Principles" },
  { href: "/about/", label: "About" },
];

const isCurrent = (href: string) =>
  href === "/" ? path === href : path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:site_name" content="Atanas Delevski" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={Astro.url} />
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {
      socialImageUrl && (
        <meta property="og:image:alt" content={socialImageAlt} />
      )
    }
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {
      socialImageUrl && (
        <meta name="twitter:image:alt" content={socialImageAlt} />
      )
    }
    <link rel="icon" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Atanas Delevski technical writing"
      href="/rss.xml"
    />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Atanas Delevski</a>
      <nav aria-label="Primary navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main class={mainClass}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="https://github.com/adelevski">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </p>
    </footer>
  </body>
</html>
