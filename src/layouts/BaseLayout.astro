---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  mainClass?: string;
}

const { title, description, mainClass } = Astro.props;
const pageTitle = title === "Nas Delevski" ? title : `${title} — Nas Delevski`;
const path = Astro.url.pathname;
const navigation = [
  { href: "https://snowball-projects.github.io", label: "snowball" },
  { href: "/writing/", label: "writing" },
];

const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'none'",
  "connect-src 'none'",
  "font-src 'self'",
  "form-action 'none'",
  "frame-src 'none'",
  "img-src 'self'",
  "manifest-src 'self'",
  "media-src 'none'",
  "object-src 'none'",
  "script-src 'none'",
  "style-src 'self' 'unsafe-inline'",
  "worker-src 'none'",
].join("; ");

const isCurrent = (href: string) =>
  href === "/" ? path === href : path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content={contentSecurityPolicy}
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0e0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nas Delevski — Writing"
      href="/rss.xml"
    />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">Nas Delevski</a>
      <nav aria-label="Primary navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main-content" class={mainClass}>
      <slot />
    </main>
  </body>
</html>
