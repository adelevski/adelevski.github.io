---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (project) => !project.data.draft,
  );

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="prose">
    <p class="eyebrow">Project · {project.data.status}</p>
    <h1>{project.data.title}</h1>
    <p class="lede">{project.data.summary}</p>

    {
      project.data.technologies.length > 0 && (
        <ul class="tag-list" aria-label="Technologies">
          {project.data.technologies.map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
      )
    }

    <div class="content">
      <Content />
    </div>

    {
      project.data.repository && (
        <p>
          <a href={project.data.repository}>View the project repository</a>
        </p>
      )
    }
  </article>
</BaseLayout>
