---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (project) => !project.data.draft,
  );

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedWriting = (await getCollection("writing"))
  .filter(
    (article) => !article.data.draft && article.data.project === project.id,
  )
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  );
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  socialImage={null}
>
  <article class="prose">
    <h1>{project.data.title}</h1>

    {
      project.data.technologies.length > 0 && (
        <ul class="tag-list" aria-label="Technologies">
          {project.data.technologies.map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
      )
    }

    <div class="content">
      <Content />
    </div>

    {
      relatedWriting.length > 0 && (
        <section class="related-content" aria-labelledby="related-writing">
          <h2 id="related-writing">Related writing</h2>
          <ul>
            {relatedWriting.map((article) => (
              <li>
                <a href={`/writing/${article.id}/`}>{article.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      project.data.repository && (
        <p>
          <a href={project.data.repository}>View the project repository</a>
        </p>
      )
    }
  </article>
</BaseLayout>
