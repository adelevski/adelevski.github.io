---
import headshot from "../assets/nas-delevski.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Nas Delevski"
  description="Nas Delevski is a quantitative developer at S&P Global and the founder of snowball."
  mainClass="home-page"
>
  <section class="profile" aria-labelledby="profile-name">
    <div class="profile__copy">
      <h1 id="profile-name">Nas Delevski</h1>
      <p>
        I’m a quantitative developer at S&amp;P Global by day and the founder of
        <a href="https://snowball-projects.github.io">snowball</a>, an
        open-source software lab, by night. I’m based in Chicago.
      </p>
    </div>
    <img
      class="profile__photo"
      src={headshot.src}
      width="512"
      height="480"
      alt="Portrait of Nas Delevski"
      decoding="async"
    />
  </section>
</BaseLayout>
