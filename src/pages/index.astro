---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => !project.data.draft && project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const latestWriting = (await getCollection("writing"))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Atanas Delevski"
  description="Selected software projects and technical writing by Atanas Delevski."
>
  <section class="hero">
    <p class="eyebrow">Quantitative developer</p>
    <h1>Selected software projects and technical writing.</h1>
    <p class="lede">
      A concise index of public work in optimization, quantitative
      experimentation, systems, and developer tooling.
    </p>
  </section>

  <section aria-labelledby="featured-projects">
    <div class="section-heading">
      <h2 id="featured-projects">Featured project</h2>
      <a href="/projects/">View all projects</a>
    </div>
    <div class="project-list">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {
    latestWriting.length > 0 && (
      <section aria-labelledby="latest-writing">
        <div class="section-heading">
          <h2 id="latest-writing">Latest writing</h2>
          <a href="/writing/">View all writing</a>
        </div>
        <ol class="article-list article-list--compact">
          {latestWriting.map((article) => (
            <li>
              <a href={`/writing/${article.id}/`}>{article.data.title}</a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</BaseLayout>
