---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Snowball"
  description="Opinionated software by Atanas Delevski."
>
  <h1 class="visually-hidden">Snowball</h1>
  <p class="home-intro">Opinionated software by Atanas Delevski.</p>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="visually-hidden">Projects</h2>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
